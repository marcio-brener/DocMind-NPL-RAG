# ==============================================================================
# DocMind — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Renomeie este arquivo para .env e altere os valores conforme seu ambiente.
# IMPORTANTE: Nunca versione o arquivo .env no controle de versão (Git)!
# ==============================================================================

# ── CONFIGURAÇÃO GERAL DA APLICAÇÃO ───────────────────────────────────────────
# Nome exibido da aplicação FastAPI nas páginas de documentação (/docs, /redoc)
APP_NAME="Plataforma NLP RAG Enterprise"

# Ambiente de execução atual: "development", "staging", "production"
APP_ENV=development

# Modo de depuração: true para exibir logs detalhados e erros detalhados, false caso contrário
DEBUG=true

# Prefixo padrão da versão 1 da API REST
API_V1_STR=/api/v1

# Chave secreta de criptografia para geração de tokens de sessão, JWT, etc.
# AVISO: Altere para uma chave forte e aleatória em produção.
SECRET_KEY=super-secret-key-change-in-production


# ── CONFIGURAÇÃO DO SERVIDOR WEB ──────────────────────────────────────────────
# Endereço IP do host onde o uvicorn será executado (0.0.0.0 escuta em todas as interfaces)
HOST=0.0.0.0

# Porta TCP de escuta do servidor web
PORT=8000


# ── CONFIGURAÇÃO DE CORS (Cross-Origin Resource Sharing) ─────────────────────
# Lista de origens permitidas em formato JSON de array de strings.
# Deixe vazio ([]) ou configure apenas origens permitidas em produção.
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]


# ── ARMAZENAMENTO E SEGMENTAÇÃO DE DOCUMENTOS (BANCO VETORIAL) ────────────────
# Caminho do diretório local onde os arquivos persistentes do ChromaDB serão salvos
CHROMADB_PATH=./data/chromadb

# Caminho redundante de persistência do ChromaDB (definido no Pydantic)
PERSIST_DIRECTORY=./data/chromadb

# Caminho do diretório local para persistência física dos documentos enviados (/upload)
UPLOAD_DIR=./data/uploads

# Tamanho máximo de arquivo permitido para uploads (em Megabytes)
MAX_FILE_SIZE_MB=10

# Tamanho de caractere desejado para cada fragmento (chunk) de texto
CHUNK_SIZE=1000

# Sobreposição (overlap) de caracteres entre chunks consecutivos para manter contexto
CHUNK_OVERLAP=150

# Nome do modelo HuggingFace local utilizado pelo sentence-transformers para gerar embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2


# ── CACHE REDIS & MENSAGERIA RABBITMQ ─────────────────────────────────────────
# URL de conexão com a base de dados do Redis (formato: redis://host:porta/db)
REDIS_URL=redis://localhost:6379/0

# Tempo de vida padrão (TTL) em segundos para armazenamento de respostas no cache Redis (1 hora)
CACHE_TTL_SECONDS=3600

# URL de conexão com o broker RabbitMQ (formato: amqp://usuario:senha@host:porta/)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Nome da fila utilizada para o processamento de tarefas em segundo plano (documentos)
RABBITMQ_QUEUE=document_processing_queue

# Nome da exchange do RabbitMQ utilizada para roteamento de mensagens de documentos
RABBITMQ_EXCHANGE=document_exchange

# Routing key do RabbitMQ para encaminhar documentos enviados à fila
RABBITMQ_ROUTING_KEY=document.process

# Fila de requisições de perguntas para o RAG
RABBITMQ_RAG_QUEUE=rag_requests

# Fila de processamento de documentos (não utilizada diretamente, mantida no Pydantic)
RABBITMQ_DOCUMENT_QUEUE=document_processing


# ── PROVEDORES DE LLM (GOOGLE GEMINI) ──────────────────────────────────────────
# Chave de API do Google AI Studio para acesso ao modelo Gemini.
# IMPORTANTE: Nunca envie sua chave de produção para o repositório Git!
GOOGLE_API_KEY=your-google-api-key-here

# Nome do modelo LLM do Gemini utilizado na geração de respostas
GEMINI_MODEL=gemini-2.5-flash

# Temperatura de criatividade do modelo (valores mais baixos = mais factual/determinístico)
LLM_TEMPERATURE=0.2

# Quantidade máxima de tokens gerados na resposta do modelo
LLM_MAX_TOKENS=2048


# ── PIPELINE RAG (RETRIEVAL AUGMENTED GENERATION) ─────────────────────────────
# Quantidade padrão de chunks de contexto recuperados do banco vetorial
DEFAULT_CONTEXT_CHUNKS=10

# Quantidade mínima de chunks de contexto recuperados do banco vetorial
MIN_CONTEXT_CHUNKS=3

# Quantidade máxima de chunks de contexto recuperados do banco vetorial
MAX_CONTEXT_CHUNKS=10

# Limite mínimo de chunks recuperados ao processar um currículo (CV)
MIN_CV_CONTEXT_CHUNKS=10

# Limite máximo de chunks recuperados ao processar um currículo (CV)
MAX_CV_CONTEXT_CHUNKS=12

# Limite mínimo de chunks recuperados ao processar requisições de resumo (Summary)
MIN_SUMMARY_CONTEXT_CHUNKS=10

# Limite máximo de chunks recuperados ao processar requisições de resumo (Summary)
MAX_SUMMARY_CONTEXT_CHUNKS=12

# Limite máximo de tokens de contexto permitidos para evitar estouro da janela do LLM
MAX_CONTEXT_TOKENS=12000

# Limiar de corte mínimo para a similaridade de cosseno híbrida dos chunks
RAG_MIN_SIMILARITY=0.25

# Tamanho máximo do trecho (excerpt) retornado na referência das fontes no JSON final (caracteres)
EXCERPT_LENGTH=400
