# Application Configuration
APP_NAME="Plataforma NLP RAG Enterprise"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database & Storage
CHROMADB_PATH=./data/chromadb
PERSIST_DIRECTORY=./data/chromadb
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=10
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Cache & Queues
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# RabbitMQ — Mensageria Event-Driven
# Formato: amqp://usuario:senha@host:porta/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DOCUMENT_QUEUE=document_processing
RABBITMQ_RAG_QUEUE=rag_requests
RABBITMQ_QUEUE=document_processing_queue
RABBITMQ_EXCHANGE=document_exchange
RABBITMQ_ROUTING_KEY=document.process

# LLM Providers
GOOGLE_API_KEY=sua_chave_real
GEMINI_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# RAG Pipeline
DEFAULT_CONTEXT_CHUNKS=10
MIN_CONTEXT_CHUNKS=3
MAX_CONTEXT_CHUNKS=10
MIN_CV_CONTEXT_CHUNKS=10
MAX_CV_CONTEXT_CHUNKS=12
MIN_SUMMARY_CONTEXT_CHUNKS=10
MAX_SUMMARY_CONTEXT_CHUNKS=12
MAX_CONTEXT_TOKENS=12000
RAG_MIN_SIMILARITY=0.35

